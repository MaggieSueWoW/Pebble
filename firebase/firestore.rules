rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function officer() {
      return request.auth != null
        && exists(/databases/$(database)/documents/officers/$(request.auth.uid))
        && get(/databases/$(database)/documents/officers/$(request.auth.uid)).data.enabled == true;
    }
    function text(value, max) { return value is string && value.size() <= max; }
    function notes(d) { return !('notes' in d) || text(d.notes, 1000); }
    function versioned() {
      let d = request.resource.data;
      return d.version is int && d.version >= 1 && d.updatedBy == request.auth.uid && d.updatedAt == request.time
        && (resource == null ? d.version == 1 : d.version == resource.data.version + 1);
    }
    function fields(d, required, optional) {
      return d.keys().hasAll(required.concat(['version', 'updatedBy', 'updatedAt']))
        && d.keys().hasOnly(required.concat(optional).concat(['version', 'updatedBy', 'updatedAt']));
    }
    function validId(value) { return value is string && value.matches('^[A-Za-z0-9_-]{1,100}$'); }
    function day(value) { return value is string && value.matches('^[0-9]{4}-(0[1-9]|1[0-2])-(0[1-9]|[12][0-9]|3[01])$'); }
    function ordered(a, b) { return a == '' || b == '' || a < b; }
    function optionalDay(value) { return value == '' || day(value); }
    function wall(value) { return value is string && (value == '' || value.matches('^[0-9]{4}-(0[1-9]|1[0-2])-(0[1-9]|[12][0-9]|3[01])T([01][0-9]|2[0-3]):[0-5][0-9]$')); }
    function availability(a) {
      return a is map && a.keys().hasAll(['mode'])
        && ((a.mode in ['automatic', 'available', 'unavailable'] && a.keys().hasOnly(['mode']))
          || (a.mode in ['partial','unavailableFor'] && a.keys().hasOnly(['mode', 'minutes']) && a.minutes is int && a.minutes >= 1 && a.minutes <= 720));
    }
    // Every linked write must advance its main in the same atomic commit.
    // Deletion reads that version, so a newly added/moved link invalidates it.
    function playerAdvanced(season, id) {
      let path = /databases/$(database)/documents/seasons/$(season)/players/$(id);
      return exists(path) && existsAfter(path)
        && getAfter(path).data.version == get(path).data.version + 1;
    }
    function complete(season, run) {
      return get(/databases/$(database)/documents/seasons/$(season)/results/$(run)).data.complete == true;
    }
    match /officers/{uid} {
      allow get: if officer() || (request.auth != null && uid == request.auth.uid);
      allow list: if officer();
    }
    // Only the trusted callable may change membership, invitations, or audit records.
    match /officerInvitations/{id} { allow read: if officer(); }
    match /officerAudit/{id} { allow read: if officer(); }
    match /bot/status { allow read: if officer(); }
    match /publicSeasons/{season} { allow read: if true; }
    match /seasons/{season} {
      allow read: if officer();
      match /reports/{code} {
        allow read: if officer();
        allow delete: if officer() && validId(season) && code.matches('^[A-Za-z0-9]{16}$');
        allow create, update: if officer() && validId(season) && versioned() && code.matches('^[A-Za-z0-9]{16}$')
          && fields(request.resource.data, ['enabled'], ['notes']) && request.resource.data.enabled is bool && notes(request.resource.data);
      }
      match /players/{id} {
        allow read: if officer();
        allow delete: if officer() && validId(season) && validId(id);
        allow create, update: if officer() && validId(season) && versioned()
          && validId(id) && fields(request.resource.data, ['name', 'className', 'role', 'active', 'joinDate', 'leaveDate'], ['notes'])
          && text(request.resource.data.name, 32) && request.resource.data.name.size() > 0
          && request.resource.data.className in ['Death Knight','Demon Hunter','Druid','Evoker','Hunter','Mage','Monk','Paladin','Priest','Rogue','Shaman','Warlock','Warrior','Unknown']
          && request.resource.data.role in ['Tank','Healer','Damage','Unknown'] && request.resource.data.active is bool
          && optionalDay(request.resource.data.joinDate) && optionalDay(request.resource.data.leaveDate)
          && (request.resource.data.joinDate == '' || request.resource.data.leaveDate == '' || request.resource.data.joinDate <= request.resource.data.leaveDate)
          && notes(request.resource.data);
      }
      match /characters/{id} {
        allow read: if officer();
        allow delete: if officer() && validId(season) && validId(id)
          && (resource.data.playerId == '' || !existsAfter(/databases/$(database)/documents/seasons/$(season)/players/$(resource.data.playerId))
            || playerAdvanced(season, resource.data.playerId));
        allow create, update: if officer() && validId(season) && versioned()
          && validId(id) && fields(request.resource.data, ['name','realm','region','playerId'], ['ignored'])
          && text(request.resource.data.name, 32) && request.resource.data.name.size() > 0
          && text(request.resource.data.realm, 100)
          && request.resource.data.region in ['us','eu','kr','tw','cn']
          && (!('ignored' in request.resource.data) || request.resource.data.ignored is bool)
          && ((request.resource.data.get('ignored', false) == true && request.resource.data.playerId == '')
            || (request.resource.data.get('ignored', false) == false && validId(request.resource.data.playerId)
              && playerAdvanced(season, request.resource.data.playerId)))
          && (resource == null || resource.data.playerId == '' || resource.data.playerId == request.resource.data.playerId
            || playerAdvanced(season, resource.data.playerId));
      }
      match /nightOverrides/{night} {
        allow read: if officer();
        allow create, update: if officer() && validId(season) && versioned() && day(night)
          && fields(request.resource.data, ['start','breakStart','breakEnd','end'], ['notes'])
          && wall(request.resource.data.start) && wall(request.resource.data.breakStart)
          && wall(request.resource.data.breakEnd) && wall(request.resource.data.end)
          && ((request.resource.data.breakStart == '') == (request.resource.data.breakEnd == ''))
          && ordered(request.resource.data.start, request.resource.data.breakStart)
          && ordered(request.resource.data.start, request.resource.data.breakEnd)
          && ordered(request.resource.data.start, request.resource.data.end)
          && ordered(request.resource.data.breakStart, request.resource.data.breakEnd)
          && ordered(request.resource.data.breakStart, request.resource.data.end)
          && ordered(request.resource.data.breakEnd, request.resource.data.end)
          && notes(request.resource.data);
      }
      match /availabilityOverrides/{id} {
        allow read: if officer();
        allow delete: if officer() && validId(season)
          && !existsAfter(/databases/$(database)/documents/seasons/$(season)/players/$(resource.data.playerId));
        allow create, update: if officer() && validId(season) && versioned()
          && fields(request.resource.data, ['nightId','playerId','pre','post'], ['notes'])
          && day(request.resource.data.nightId) && validId(request.resource.data.playerId)
          && id == request.resource.data.nightId + '_' + request.resource.data.playerId
          && (resource == null || (request.resource.data.nightId == resource.data.nightId && request.resource.data.playerId == resource.data.playerId))
          && playerAdvanced(season, request.resource.data.playerId)
          && availability(request.resource.data.pre) && availability(request.resource.data.post) && notes(request.resource.data);
      }
      match /settings/calculation {
        allow read: if officer();
        allow create, update: if officer() && validId(season) && versioned()
          && fields(request.resource.data, ['tz','breakWindowStart','breakWindowEnd','minBreakMinutes','maxBreakMinutes','defaultMythicStart','postExtensionMinutes'], [])
          && request.resource.data.tz == 'America/Los_Angeles'
          && request.resource.data.breakWindowStart.matches('^([01][0-9]|2[0-3]):[0-5][0-9]$')
          && request.resource.data.breakWindowEnd.matches('^([01][0-9]|2[0-3]):[0-5][0-9]$')
          && (request.resource.data.defaultMythicStart == '' || request.resource.data.defaultMythicStart.matches('^([01][0-9]|2[0-3]):[0-5][0-9]$'))
          && request.resource.data.breakWindowStart < request.resource.data.breakWindowEnd
          && request.resource.data.minBreakMinutes is int && request.resource.data.maxBreakMinutes is int
          && request.resource.data.minBreakMinutes >= 1 && request.resource.data.maxBreakMinutes <= 120
          && request.resource.data.minBreakMinutes <= request.resource.data.maxBreakMinutes
          && request.resource.data.postExtensionMinutes is number && request.resource.data.postExtensionMinutes >= 0 && request.resource.data.postExtensionMinutes <= 60;
      }
      match /runs/{run} {
        allow read: if officer();
        allow create: if officer() && validId(season) && validId(run) && request.resource.data.keys().hasOnly(['status','requestedBy','requestedAt'])
          && request.resource.data.status == 'queued' && request.resource.data.requestedBy == request.auth.uid
          && request.resource.data.requestedAt == request.time;
      }
      match /results/{run} {
        allow get: if officer() || resource.data.complete == true;
        match /players/{id} { allow read: if officer() || complete(season, run); }
        match /nights/{night} { allow read: if officer() || complete(season, run); }
        match /weeks/{week} { allow read: if officer() || complete(season, run); }
      }
    }
  }
}
