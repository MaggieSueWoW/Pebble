# Copy to ignored deploy/private/deploy.env and reuse it across releases.
# Compose runs on the Mac; bind sources below exist on the Docker host.
PEBBLE_WEB_IMAGE=pebble-web:REPLACE_WITH_COMMIT
PEBBLE_WEB_RUNTIME_DIR=/absolute/host/private/pebble-web
# Reuse this stable secrets file for every release.
# Optional override; Compose defaults to deploy/private/worker.env in the checkout.
PEBBLE_WEB_ENV_FILE=/absolute/client/path/deploy/private/worker.env
# Match ownership of the private host files and shared locks directory.
PEBBLE_WEB_UID=10001
PEBBLE_WEB_GID=10001
