# Copy outside the repository to a private deployment environment file.
# Compose runs on the Mac; bind sources below exist on the Docker host.
PEBBLE_WEB_IMAGE=pebble-web:REPLACE_WITH_COMMIT
PEBBLE_WEB_RUNTIME_DIR=/volume1/homes/mike/pebble-web
PEBBLE_WEB_ENV_FILE=/absolute/client/path/wcl.env
# Match ownership of the private host files and shared locks directory.
PEBBLE_WEB_UID=1026
PEBBLE_WEB_GID=100
