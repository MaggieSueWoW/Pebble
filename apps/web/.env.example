# Firebase web configuration is public. Never put service-account keys here.
VITE_FIREBASE_API_KEY=replace-with-web-api-key
VITE_FIREBASE_AUTH_DOMAIN=your-project.firebaseapp.com
VITE_FIREBASE_PROJECT_ID=your-project
VITE_FIREBASE_APP_ID=replace-with-app-id
VITE_PEBBLE_SEASON_ID=midnight-s2
VITE_PEBBLE_SEASON_LABEL=Midnight S2
VITE_FIREBASE_USE_EMULATORS=false
# For local emulator testing, use project demo-pebble and a nonempty demo API key/app ID.
