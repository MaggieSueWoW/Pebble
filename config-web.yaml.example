# Copy to config-web.yaml and adjust project/season to switch environments.
firestore:
  project_id: YOUR_FIREBASE_PROJECT_ID
  season_id: midnight-s2
  # Optional; otherwise use Google Application Default Credentials.
  # credentials_file: .pebble-service-account.json
mongo:
  uri: mongodb://localhost:27017
  db: pebble
wcl:
  # Overridden by WCL_CLIENT_ID and WCL_CLIENT_SECRET in .env.
  client_id: ''
  client_secret: ''
redis:
  url: redis://localhost:6379/0
  key_prefix: 'pebble:wcl:'
